{
  "display_information": {
    "name": "slack-claude-remote",
    "description": "Talk to a local Claude Code session from a Slack thread."
  },
  "features": {
    "bot_user": {
      "display_name": "sccr",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/cc",
        "url": "https://slcc.fuga.jp/slack/commands",
        "description": "Connect this channel to a Claude Code session",
        "usage_hint": "[list|unbind|help]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://slcc.fuga.jp/auth/callback"
    ],
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "channels:history",
        "groups:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://slcc.fuga.jp/slack/events",
      "bot_events": [
        "message.channels",
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://slcc.fuga.jp/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
