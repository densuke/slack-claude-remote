# sccr-relay の環境変数。/etc/sccr/env に配置する（root:sccr, 600 を推奨）。
# 空にすると SCCR_DEV=1 以外では起動しない項目がある（config.rs の from_env を参照）。

# 待受アドレス。省略時は 127.0.0.1:8080
SCCR_BIND=127.0.0.1:8080

# 公開 URL。OIDC の redirect_uri と /auth/callback の組み立てに使う。末尾にスラッシュを付けない
SCCR_PUBLIC_URL=https://sccr.example.jp

# 状態ファイルのパス。省略時は ./sccr-state.json（WorkingDirectory 基準）
SCCR_STATE_FILE=/var/lib/sccr/sccr-state.json

# ログインを許可する唯一の Slack user ID。空だと誰もログインできない
SCCR_ADMIN_SLACK_USER=

# Slack アプリの設定値（Basic Information / OAuth & Permissions から取得）
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# 開発モード。1 にすると Slack の秘密なしで起動でき、/agent/ws がトークン "dev" を受理し、
# Slack への投稿が LogSlack で標準出力に出る。本番では絶対に設定しない
SCCR_DEV=
